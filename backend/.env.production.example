# Replace every value with the credentials from your managed services. Do not commit this file after adding secrets.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DATABASE?ssl=require
REDIS_URL=redis://REDIS_HOST:6379/0
JWT_SECRET=generate-a-long-random-secret
# Comma-separated public frontend domains.
CORS_ORIGINS=https://your-project.vercel.app
